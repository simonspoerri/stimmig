---
import Base from '../layouts/Base.astro';
import { listVotes } from '../lib/api.ts';
import { formatDate, t } from '../lib/i18n.ts';

const votes = await listVotes();
---

<Base>
  <h1>{t.homeTitle}</h1>
  <p class="lead">{t.homeLead}</p>

  <h2>{t.navVotes}</h2>
  {
    votes.length === 0 ? (
      <p class="muted">{t.homeEmpty}</p>
    ) : (
      <ul class="votes">
        {votes.map((vote) => (
          <li>
            <a href={`/vorlagen/${vote.id}/`}>{vote.title}</a>
            <span>
              {formatDate(vote.date)} · {t.kinds[vote.kind]} · {t.counts(vote.fact_count, vote.visualization_count)}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .votes { list-style: none; padding: 0; margin: 0; }
  .votes li { padding: 14px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }
  .votes a { font-weight: 600; font-size: 1.1rem; text-decoration: none; }
  .votes span { color: var(--muted); font-size: 0.9rem; }
</style>
